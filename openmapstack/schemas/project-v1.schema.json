{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmapstack/schemas/project-v1.schema.json",
  "title": "OpenMapStack project manifest v1",
  "type": "object",
  "required": [
    "schema", "project", "interpretation", "sources", "overrides",
    "processing", "outputs", "validation", "presentation", "runtime", "runs"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
    },
    "fieldIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "safeProjectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "jsonScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "runtimeParameter": {
      "type": "object",
      "required": ["id", "type", "canonical", "binding"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["integer", "number", "string"]},
        "canonical": {"type": ["integer", "number", "string"]},
        "binding": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "argument": {"type": "string", "pattern": "^--[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
            "environment": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
          }
        },
        "step": {"type": "string", "minLength": 1},
        "field": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string"}
      },
      "dependentRequired": {"step": ["field"], "field": ["step"]}
    },
    "metamorphicRelation": {
      "type": "object",
      "required": ["id", "relation", "outputs", "key"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "relation": {
          "enum": ["input_permutation_invariance", "duplicate_resistance", "positive_buffer_monotonicity"]
        },
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "key": {"$ref": "#/$defs/identifier"},
        "source": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {"path": {"$ref": "#/$defs/safeProjectPath"}}
        },
        "parameter": {"$ref": "#/$defs/identifier"},
        "variant": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "multiply": {"type": "number", "exclusiveMinimum": 1},
            "add": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "preconditions": {"type": "object"},
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ignored_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "round_numbers": {"type": "integer", "minimum": 0}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_s": {"type": "number", "exclusiveMinimum": 0},
            "max_source_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "seed": {"type": "integer"},
        "description": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"relation": {"const": "positive_buffer_monotonicity"}}},
          "then": {"required": ["parameter", "variant", "preconditions"], "not": {"required": ["source"]}},
          "else": {
            "required": ["source"],
            "not": {"anyOf": [{"required": ["parameter"]}, {"required": ["variant"]}]}
          }
        }
      ]
    },
    "sourcePin": {
      "type": "object",
      "required": ["class", "captured_at"],
      "properties": {
        "class": {"enum": ["local_snapshot", "backend_snapshot"]},
        "captured_at": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safeProjectPath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "identifier": {"type": "string", "minLength": 1},
        "retention_until": {"type": "string", "minLength": 1},
        "verification": {
          "type": "object",
          "required": ["at", "status"],
          "properties": {
            "at": {"type": "string", "minLength": 1},
            "status": {"enum": ["accessible", "inaccessible"]}
          }
        },
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"class": {"const": "local_snapshot"}}},
          "then": {"required": ["path", "sha256"]},
          "else": {"required": ["identifier", "retention_until"]}
        }
      ]
    },
    "connectionReference": {
      "description": "A credential reference (env:, file:, service:, keyring:). The shape is open here so that an embedded DSN is rejected by the semantic credential check with a useful message rather than by a regex.",
      "type": ["string", "object"]
    },
    "warehouseSource": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "account": {"type": "string"},
        "database": {"type": "string"},
        "schema": {"type": "string"},
        "table": {"type": "string"},
        "query_sha256": {"$ref": "#/$defs/digest"},
        "schema_sha256": {"$ref": "#/$defs/digest"},
        "snapshot_capability": {"type": "string"}
      }
    },
    "expectationAttestation": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["unverified", "verified"]},
        "reason": {"type": "string", "minLength": 1},
        "verified_by": {"type": "string", "minLength": 1},
        "verified_against": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "evidence_path": {"$ref": "#/$defs/safeProjectPath"},
        "evidence_sha256": {"$ref": "#/$defs/digest"},
        "expectation_sha256": {"$ref": "#/$defs/digest"},
        "inputs_hash": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {
            "required": [
              "verified_by", "verified_against", "verified_at",
              "evidence_sha256", "expectation_sha256", "inputs_hash"
            ]
          }
        }
      ]
    },
    "expectation": {
      "type": "object",
      "required": ["id", "check", "args", "attestation"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "check": {
          "enum": [
            "geodata.row_count",
            "geodata.feature_present",
            "geodata.feature_absent",
            "geodata.feature_field_equals",
            "geodata.field_range"
          ]
        },
        "args": {"type": "object"},
        "attestation": {"$ref": "#/$defs/expectationAttestation"}
      },
      "allOf": [
        {
          "if": {"properties": {"check": {"const": "geodata.row_count"}}},
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": ["path"],
                "additionalProperties": false,
                "properties": {
                  "path": {"$ref": "#/$defs/safeProjectPath"},
                  "equals": {"type": "integer", "minimum": 0},
                  "at_least": {"type": "integer", "minimum": 0},
                  "at_most": {"type": "integer", "minimum": 0}
                },
                "anyOf": [
                  {"required": ["equals"]},
                  {"required": ["at_least"]},
                  {"required": ["at_most"]}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "check": {"enum": ["geodata.feature_present", "geodata.feature_absent"]}
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": ["path", "id_field", "id"],
                "additionalProperties": false,
                "properties": {
                  "path": {"$ref": "#/$defs/safeProjectPath"},
                  "id_field": {"$ref": "#/$defs/fieldIdentifier"},
                  "id": {"$ref": "#/$defs/jsonScalar"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"check": {"const": "geodata.feature_field_equals"}}},
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": ["path", "id_field", "id", "field", "equals"],
                "additionalProperties": false,
                "properties": {
                  "path": {"$ref": "#/$defs/safeProjectPath"},
                  "id_field": {"$ref": "#/$defs/fieldIdentifier"},
                  "id": {"$ref": "#/$defs/jsonScalar"},
                  "field": {"$ref": "#/$defs/fieldIdentifier"},
                  "equals": {"$ref": "#/$defs/jsonScalar"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"check": {"const": "geodata.field_range"}}},
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": ["path", "field"],
                "additionalProperties": false,
                "properties": {
                  "path": {"$ref": "#/$defs/safeProjectPath"},
                  "field": {"$ref": "#/$defs/fieldIdentifier"},
                  "min": {"type": "number"},
                  "max": {"type": "number"}
                },
                "anyOf": [
                  {"required": ["min"]},
                  {"required": ["max"]}
                ]
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema": {"const": "openmapstack-project/v1"},
    "project": {
      "type": "object",
      "required": ["id", "title", "question", "created_at", "updated_at", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "in_progress", "validated", "warning", "failed"]}
      }
    },
    "interpretation": {
      "type": "object",
      "required": ["objective", "assumptions"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array"}
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "pin": {"$ref": "#/$defs/sourcePin"},
          "warehouse": {"$ref": "#/$defs/warehouseSource"},
          "access": {
            "type": "object",
            "properties": {"connection": {"$ref": "#/$defs/connectionReference"}}
          }
        }
      }
    },
    "overrides": {"type": "array"},
    "processing": {
      "type": "object",
      "required": ["analysis_crs", "steps"],
      "properties": {
        "analysis_crs": {"type": "string", "minLength": 1},
        "storage_crs": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1}
      }
    },
    "outputs": {"type": "object", "minProperties": 1},
    "validation": {
      "type": "object",
      "required": ["required", "domain_checks"],
      "properties": {
        "required": {"type": "array"},
        "domain_checks": {"type": "array"},
        "expectations": {
          "type": "array",
          "items": {"$ref": "#/$defs/expectation"}
        },
        "metamorphic": {
          "type": "array",
          "items": {"$ref": "#/$defs/metamorphicRelation"}
        }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "map": {
          "type": "object",
          "required": ["basemap"],
          "properties": {
            "basemap": {
              "type": "object",
              "required": ["id", "attribution"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["raster-xyz", "raster-wms", "vector-style"]},
                "tiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "url": {"type": "string", "minLength": 1},
                "attribution": {"type": "string", "minLength": 1},
                "default_visible": {"type": "boolean"}
              },
              "anyOf": [{"required": ["tiles"]}, {"required": ["url"]}]
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["implementation"],
      "properties": {
        "implementation": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {"$ref": "#/$defs/runtimeParameter"}
            }
          },
          "anyOf": [
            {"required": ["pipeline"]},
            {"required": ["command"]}
          ]
        }
      }
    },
    "runs": {
      "type": "object",
      "required": ["latest"],
      "properties": {
        "latest": {
          "type": "object",
          "required": [
            "id", "started_at", "completed_at", "status",
            "inputs_hash", "outputs_hash", "validation_report"
          ],
          "properties": {
            "status": {"enum": ["passed", "warning", "failed"]}
          }
        }
      }
    }
  }
}
