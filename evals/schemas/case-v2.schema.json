{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmapstack/schemas/eval-case-v2.schema.json",
  "type": "object",
  "required": ["id", "case_type", "modes", "score_types", "assertions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "case_type": {"enum": ["positive", "mutation"]},
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fixture", "live"]}
    },
    "score_types": {
      "type": "object",
      "additionalProperties": {
        "enum": ["contract_ci", "mutation_tests", "agent_benchmark", "integration_visual"]
      }
    },
    "fixture": {"type": "object"},
    "live": {"type": "object"},
    "mutation": {
      "type": "object",
      "required": ["control_generator"],
      "additionalProperties": false,
      "properties": {
        "control_generator": {"type": "string", "minLength": 1}
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assert"],
        "properties": {
          "assert": {"type": "string", "pattern": "^[a-z_]+[.][a-z_]+$"},
          "args": {"type": "object"},
          "expect": {"enum": ["passed", "failed", "warning", "not_testable"]},
          "expect_code": {"type": "string", "minLength": 1},
          "hard_gate": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"case_type": {"const": "mutation"}}},
      "then": {"required": ["mutation"]},
      "else": {"not": {"required": ["mutation"]}}
    }
  ]
}
